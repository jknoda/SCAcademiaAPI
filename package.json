{
  "name": "judo-analisys-system",
  "version": "1.0.0",
  "description": "AI - Judo analysis system",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --target=node22 --sourcemap --outfile=dist/index.js",
    "start": "node dist/index.js",
    "dev": "node --experimental-strip-types --env-file .env src/index.ts",
    "start:local": "node --env-file .env dist/index.js",
    "test": "node --experimental-strip-types --env-file .env --test tests/**/*.test.ts",
    "test:dev": "node --experimental-strip-types --env-file .env --test --watch tests/**/*.test.ts",
    "langgraph:serve": "npx @langchain/langgraph-cli dev",
    "heroku-postbuild": "npm run build"
  },
  "keywords": [
    "langchain",
    "langgraph",
    "memory",
    "libsql",
    "judo",
    "openrouter"
  ],
  "author": "jorgenoda",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.10.13",
    "@types/pg": "^8.20.0",
    "esbuild": "^0.25.11",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@huggingface/inference": "^4.13.12",
    "@huggingface/transformers": "^3.8.1",
    "@langchain/community": "^1.1.14",
    "@langchain/core": "^1.1.22",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.0",
    "@langchain/langgraph-checkpoint-sqlite": "^1.0.1",
    "@libsql/client": "^0.17.0",
    "@openrouter/sdk": "^0.8.0",
    "@xenova/transformers": "^2.0.1",
    "better-sqlite3": "^11.10.0",
    "knex": "^3.1.0",
    "langchain": "^1.2.21",
    "pg": "^8.20.0"
  }
}
